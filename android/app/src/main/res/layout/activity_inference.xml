<?xml version="1.0" encoding="utf-8"?>
<!-- On a tall phone everything fits and the picture area takes the spare room. On a short
     phone the picture area keeps its minimum height and the page scrolls instead. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inf_bg"
    android:fillViewport="true"
    android:padding="12dp">

<LinearLayout
    android:id="@+id/infContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back to the recorder"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/inf_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Test a model"
            android:textColor="@color/inf_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- model picker -->
    <LinearLayout
        android:id="@+id/modelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/inf_card_click"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="MODEL"
                android:textColor="@color/inf_text2"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/inf_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modelSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/inf_text2"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Change"
            android:textColor="@color/inf_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- what the chosen model needs, and whether it is ready -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/inf_card"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:textColor="@color/inf_text2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipGlove"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/inf_card"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:textColor="@color/inf_text2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipCal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/inf_card_click"
            android:clickable="true"
            android:focusable="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:textColor="@color/inf_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="Also use the camera (how this model was trained)"
        android:textColor="@color/inf_text2"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- camera picture / glove panel -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/inf_stage"
        android:minHeight="176dp">

        <com.aisla.app.OverlayView
            android:id="@+id/infOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.aisla.app.GloveView
            android:id="@+id/gloveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:shadowColor="#000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFlip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="@drawable/inf_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Flip camera"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/windowProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressDrawable="@drawable/inf_progress"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- result -->
    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/inf_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resultLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="–"
                android:textColor="@color/inf_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultConf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/inf_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="2"
            android:textColor="@color/inf_text2"
            android:textSize="13sp" />

        <com.aisla.app.ProbBarsView
            android:id="@+id/bars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/resultDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/inf_text2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- mode + main action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/inf_segment_bg"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/modeLive"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Live"
                android:textColor="@color/inf_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeTake"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="4 s take"
                android:textColor="@color/inf_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/inf_primary"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/inf_on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
